/* ═══════════════════════════════════════════════════════════════
   global.qss  —  Estilos base de toda la aplicación
   Los tokens {{TOKEN}} son reemplazados por styles/loader.py
   ═══════════════════════════════════════════════════════════════ */

/* ── Base ─────────────────────────────────────────────────── */
QMainWindow,
QWidget {
    background-color: {{BG_DARK}};
    color: {{TEXT_PRIMARY}};
    font-family: 'Segoe UI', 'Inter', sans-serif;
    font-size: {{SIZE_BASE}};
}

/* ── Menú ─────────────────────────────────────────────────── */
QMenuBar {
    background-color: {{BG_DARK}};
    color: {{TEXT_PRIMARY}};
    border-bottom: 1px solid {{BORDER_DIM}};
    padding: 2px 6px;
}
QMenuBar::item:selected {
    background-color: {{BG_CARD}};
    border-radius: {{RADIUS_MD}};
}
QMenu {
    background-color: {{BG_CARD}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER_DIM}};
}
QMenu::item:selected {
    background-color: {{ACCENT_BLUE}};
}

/* ── Tabla ────────────────────────────────────────────────── */
QTableWidget {
    background-color: {{BG_TABLE}};
    gridline-color: {{BORDER_DIM}};
    border: none;
    outline: none;
    selection-background-color: {{BG_ROW_SEL}};
    selection-color: {{TEXT_PRIMARY}};
}
QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid {{BORDER_DIM}};
}
QTableWidget::item:selected {
    background-color: {{BG_ROW_SEL}};
    color: {{TEXT_PRIMARY}};
}
QHeaderView::section {
    background-color: {{BG_HEADER}};
    color: {{TEXT_HEADER}};
    font-size: {{SIZE_HDR}};
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid {{BORDER_DIM}};
    text-transform: uppercase;
}

QHeaderView::section:hover {
    background-color: #1f2937;
    color: white;
}

QHeaderView::section:pressed {
    background-color: #111827;
    color: white;
}

/* ── Scrollbar ────────────────────────────────────────────── */
QScrollBar:vertical {
    background: {{BG_DARK}};
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: {{SCROLLBAR_HDL}};
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    background: {{BG_DARK}};
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: {{SCROLLBAR_HDL}};
    border-radius: 3px;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0px; }

/* ── Slider ───────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: {{SLIDER_BG}};
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: {{SLIDER_TRACK}};
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: {{SLIDER_HANDLE}};
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* ── Label transparente por defecto ──────────────────────── */
QLabel {
    background: transparent;
}
