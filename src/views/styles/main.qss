QMainWindow,
QWidget#central {
    background: #1a1a1e;
}

/* ───────────────────── MENÚ ───────────────────── */

QMenuBar {
    background: #26262c;
    color: #e8e8f0;
    font-family: Courier;
    font-size: 11px;
    padding: 2px 0;
    border-bottom: 1px solid #3a3a44;
}

QMenuBar::item:selected {
    background: #5865f2;
    border-radius: 4px;
}

QMenu {
    background: #26262c;
    color: #e8e8f0;
    font-family: Courier;
    font-size: 11px;
    border: 1px solid #3a3a44;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item:selected {
    background: #5865f2;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background: #3a3a44;
    margin: 4px 8px;
}

/* ───────────────── CONFIG ───────────────── */

QFrame#config_card {
    background: #26262c;
    border-radius: 6px;
}

QLabel#label_ruta {
    color: #6b6b80;
    font-family: Courier;
    font-size: 9px;
    font-weight: bold;
}

QLineEdit#entry_ruta {
    background: #2e2e36;
    color: #6b6b80;
    font-family: Courier;
    font-size: 10px;
    border: 1px solid #3a3a44;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ───────────────── BOTONES ───────────────── */

QPushButton#btn_cambiar {
    background: #2e2e36;
    color: #e8e8f0;
    font-family: Courier;
    font-size: 9px;
    border: 1px solid #3a3a44;
    border-radius: 4px;
    padding: 5px 14px;
}

QPushButton#btn_cambiar:hover {
    background: #3a3a44;
}

QPushButton#btn_confirmar {
    background: #5865f2;
    color: #e8e8f0;
    font-family: Courier;
    font-size: 10px;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 9px 18px;
}

QPushButton#btn_confirmar:hover {
    background: #4752c4;
}

QPushButton#btn_confirmar:disabled {
    background: #3a3a44;
    color: #6b6b80;
}

/* ───────────────── TREE ───────────────── */

QTreeWidget {
    background: #26262c;
    color: #e8e8f0;
    font-family: Courier;
    font-size: 10px;
    border: none;
    outline: none;
    alternate-background-color: #2e2e36;
}

QTreeWidget::item {
    padding: 4px 0;
}

QTreeWidget::item:selected {
    background: #5865f2;
}

QHeaderView::section {
    background: #2e2e36;
    color: #6b6b80;
    font-family: Courier;
    font-size: 9px;
    font-weight: bold;
    border: none;
    border-right: 1px solid #3a3a44;
    border-bottom: 1px solid #3a3a44;
    padding: 5px 8px;
}

QHeaderView::section:hover {
    color: #e8e8f0;
}

/* ───────────────── SCROLL ───────────────── */

QScrollBar:vertical {
    background: #1a1a1e;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #3a3a44;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #6b6b80;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ───────────────── OTROS ───────────────── */

QFrame#separator {
    background: #3a3a44;
}